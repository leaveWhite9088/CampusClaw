# 会话签名密钥（必填；仅存在于服务端环境变量，禁止提交真实值）
SECRET_KEY=

# app 容器内监听端口（仅 Compose 内部网络可达，不映射到宿主）
PORT=8000

# 向量库（Compose 内部地址，无需修改；qdrant 服务不映射宿主机端口）
QDRANT_URL=http://qdrant:6333

# 嵌入网关（OpenAI 兼容 /embeddings；不配置则向量/混合检索降级为 503，关键字检索仍可用）
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 对话网关（OpenAI 兼容 /chat/completions；仅检索命中切片后调用）
CHAT_API_BASE=
CHAT_API_KEY=
CHAT_MODEL=
